{
  "name": "thenegronipony",
  "version": "0.1.0",
  "private": true,
  "description": "The Negroni Pony open-source cocktail art machine.",
  "type": "module",
  "engines": {
    "node": "22",
    "pnpm": "10"
  },
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "cd site && ../node_modules/.bin/vite dev --port 5310",
    "build": "cd site && ../node_modules/.bin/vite build",
    "biome": "biome check . --write",
    "lint": "biome check .",
    "test": "cd site && ../node_modules/.bin/vitest run --config vitest.config.ts --passWithNoTests && cd .. && pnpm test:worker",
    "test:worker": "vitest run --config worker/vitest.config.ts",
    "typecheck": "cd site && ../node_modules/.bin/react-router typegen && cd .. && tsc -p site/tsconfig.json --noEmit && pnpm typecheck:worker",
    "typecheck:worker": "tsc -p worker/tsconfig.json --noEmit",
    "calibration:recipes:generate": "node worker/scripts/generate-recipes.mjs",
    "calibration:recipes:check": "node worker/scripts/generate-recipes.mjs --check",
    "cloudflare:types": "wrangler types worker-configuration.d.ts --env local",
    "cloudflare:dry-run": "pnpm build && wrangler deploy --dry-run --env local",
    "needful": "pnpm biome && pnpm typecheck && pnpm build && pnpm test",
    "cloudflare:deploy": "pnpm build && wrangler deploy",
    "cloudflare:preview": "pnpm build && wrangler versions upload --env preview"
  },
  "dependencies": {
    "@react-router/node": "7.11.0",
    "clsx": "2.1.1",
    "isbot": "5.1.31",
    "canonicalize": "4.0.0",
    "jose": "6.2.9",
    "lucide-react": "0.562.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router": "7.11.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@cloudflare/vitest-pool-workers": "0.21.3",
    "@react-router/dev": "7.11.0",
    "@tailwindcss/vite": "4.1.16",
    "@types/node": "22.8.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "lefthook": "1.11.13",
    "tailwindcss": "4.1.16",
    "typescript": "5.8.3",
    "vite": "6.3.3",
    "wrangler": "4.123.0",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
